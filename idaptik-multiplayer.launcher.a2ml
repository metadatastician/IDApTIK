#
# idaptik-multiplayer.launcher.a2ml — per-app launcher config for the IDApTIK
# two-player netplay launcher. Compliant with launcher-standard.a2ml v0.3.0.
#
# The launcher script is HAND-AUTHORED (generator = "hand-authored"): the
# launch-scaffolder's runtime kinds (server-url, binary, …) do not model a
# two-seat host/join TUI game, so the script implements the standard's
# required modes directly and adds the game-specific `host`/`join` modes.

[project]
name         = "idaptik-multiplayer"
display      = "IDApTIK Multiplayer"
description  = "Two-player Ghost Lobby netplay: host the relay and a seat, or join a friend's session"
categories   = ["Game", "Network"]
version      = "0.1.0"
license      = "AGPL-3.0-or-later"

[repo]
# Resolved at runtime from the launcher script's own location.
path = ""

[runtime]
kind = "tui-netplay"
# The Phoenix relay the host mode starts; join mode connects to a peer's.
port = 4000
# Both seats read the shared deterministic run config from this fixture —
# same repo, same file, same seed on both machines.
run-config = "fixtures/session_relay/versus_script.json"
pid-file = "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/idaptik-relay.pid"
log-file = "${XDG_STATE_HOME:-$HOME/.local/state}/idaptik-multiplayer/relay.log"
wait-for-url-timeout-seconds = 60

[version-output]
first-line-format = "idaptik-multiplayer-launcher {version} ({build-sha-short}) [{platform}]"

[modes]
# Standard required modes, plus the game-specific pair.
runtime     = ["--start", "--stop", "--status", "--auto"]
integration = ["--integ", "--disinteg"]
meta        = ["--help", "--version"]
extra       = ["host", "join"]
