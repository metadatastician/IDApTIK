# SPDX-License-Identifier: MPL-2.0

* text=auto eol=lf

# Source
*.rs    text eol=lf diff=rust
*.ex    text eol=lf
*.exs   text eol=lf
*.zig   text eol=lf diff=zig
*.idr   text eol=lf
*.ncl   text eol=lf
*.scm   text eol=lf
*.nix   text eol=lf
*.sh    text eol=lf

# Documentation, configuration, and fixtures
*.md    text eol=lf diff=markdown
*.adoc  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.html  text eol=lf diff=html
*.css   text eol=lf diff=css
*.svg   text eol=lf
justfile text eol=lf

# Lock files are reproducibility inputs, but their generated diffs are noisy.
Cargo.lock      text eol=lf -diff
server/mix.lock text eol=lf -diff

# Assets and archives
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.woff2 binary
*.zip   binary
*.gz    binary
