# EditorConfig for the Rust/Elixir/Nickel IDApTIK workspace.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,zig}]
indent_size = 4

[*.{ex,exs,ncl,yml,yaml,json,toml,nix,scm,idr}]
indent_size = 2

[*.{md,adoc}]
trim_trailing_whitespace = false

[justfile]
indent_size = 4
