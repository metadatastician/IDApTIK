let%span strace = "crates/idaptik-kernel/src/trace.rs" 23 4 23 17
let%span strace'0 = "crates/idaptik-kernel/src/trace.rs" 24 4 24 18

use creusot.int.UInt32
use creusot.prelude.Any

type t_Trace = { progress: UInt32.t; threshold: UInt32.t }

let clone_u32 (self_: UInt32.t) (return (x: UInt32.t)) = any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:clone ensures] [%#snum] result = self_} (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Trace [#"crates/idaptik-kernel/src/trace.rs" 20 16 20 21] (self: t_Trace) (return (x: t_Trace)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_4 <- self.progress ] s1
    | s1 = clone_u32 [%#strace] {_4} (fun (_x: UInt32.t) -> [ &_2 <- _x ] s2)
    | s2 = [ &_7 <- self.threshold ] s3
    | s3 = clone_u32 [%#strace'0] {_7} (fun (_x: UInt32.t) -> [ &_5 <- _x ] s4)
    | s4 = [ &_ret <- { progress = _2; threshold = _5 } ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_Trace = Any.any_l ()
  | & self: t_Trace = self
  | & _2: UInt32.t = Any.any_l ()
  | & _4: UInt32.t = Any.any_l ()
  | & _5: UInt32.t = Any.any_l ()
  | & _7: UInt32.t = Any.any_l () ]) [ return (result: t_Trace) -> (! return {result}) ]
