let traced [#"crates/idaptik-kernel/src/trace.rs" 92 4 92 32] (self: t_Trace) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- UInt32.ge self.progress self.threshold ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & self: t_Trace = self ])
