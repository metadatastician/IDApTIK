type t_Alert = FailedLogin | PortScan | FirewallTrip | PowerCut

type t_AlertDeepModel = FailedLogin'0 | PortScan'0 | FirewallTrip'0 | PowerCut'0

function deep_model_Alert [#"crates/idaptik-kernel/src/trace.rs" 135 27 135 56] (self: t_Alert) : t_AlertDeepModel =
  [%#strace'0] match self with
    | FailedLogin -> FailedLogin'0
    | PortScan -> PortScan'0
    | FirewallTrip -> FirewallTrip'0
    | PowerCut -> PowerCut'0
