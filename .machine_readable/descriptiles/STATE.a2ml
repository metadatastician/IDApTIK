# SPDX-License-Identifier: MPL-2.0
# STATE.a2ml — current IDApTIK project state

[metadata]
project = "IDApTIK"
version = "0.1.0"
type = "game"
last-updated = "2026-07-26"
branch = "main"
build-status = "Envelope vertical slice implemented; player-facing GUI incomplete"
test-status = "Rust core/TUI/FFI/net, Nickel contracts, Elixir relay, and two-seat loopback are CI-gated"

[project-context]
description = "Asymmetric two-player infiltration game. One player infiltrates a physical space; the other hacks a grounded network simulation."
subtitle = "Invisible Door: Action Point Trauma Inc. Kickers"
truth-language = "rust"
session-language = "elixir"
ffi-language = "zig"
abi-model-language = "idris2"
config-language = "nickel"
selected-renderer = "bevy"
planned-host = "gossamer"
planned-transport = "burble"
runtime-dependencies = ["bevy", "bandit", "phoenix_channels", "nickel"]

[roadmap]
phases = "Envelope > Wheel > Skateboard > Bicycle > Chassis > Motorcycle > Computer Game"
current-phase = "Envelope"
phase-goal = "Turn the proven Ghost Lobby/TUI/netplay slice into a coherent player-facing Bevy prototype with first art and documented mechanics."

[component-status]
core = { status = "live", notes = "Deterministic event-sourced Ghost Lobby, building runtime, grounded network, actors, snapshots, package loading, and replay." }
net = { status = "live", notes = "Two-seat delay lockstep, pacing, pause, peer loss, digest checks, snapshot resync, and interactive client." }
ffi = { status = "live", notes = "C ABI drives the real Ghost Lobby simulation with JSON command/event and snapshot parity." }
tui = { status = "live", notes = "Playable reference frontend plus headless, replay, and export verification." }
bevy-frontend = { status = "selected-partial", notes = "Working renderer, HUD, keymap, interpolation, and parity tests; full player-facing shell and visual validation remain." }
server = { status = "live", notes = "Bandit/Phoenix typed Command/Event relay with role routing, de-duplication, and loopback evidence." }
config = { status = "live", notes = "Nickel schemas, positive exports, semantic Rust round-trip, and negative fixtures." }
ums-package = { status = "live-v1", notes = "IDApTIK-owned v1 package syntax, loader, semantic validation, deterministic execution, snapshot/restore, and replay." }
moletaire = { status = "tested-seam", notes = "Deterministic companion module exists but is not wired into GhostLobbySim." }

[settled-decisions]
items = [
  { item = "Bevy is the selected graphical frontend; Fyrox is retired", ref = "ADR-0008" },
  { item = "IDApTIK owns the versioned UMS package boundary", ref = "ADR-0007" },
  { item = "Elixir is a relay-only session layer for the current vertical slice", ref = "ADR-0005" },
]

[open-decisions]
remaining = [
  { item = "Persistence and save-compatibility policy", resolve-by = "post-Envelope" },
  { item = "Long-term Rust/Elixir wire encoding beyond the current JSON contract", resolve-by = "post-Envelope", ref = "ADR-0005" },
  { item = "Canonical era versus switchable style axis", resolve-by = "before substantial asset production" },
  { item = "Public relay, matchmaking, and authoritative-host policy", resolve-by = "before public playtesting" },
]

[route-to-mvp]
remaining = [
  { item = "Build the Bevy product shell: launch, session/seat choice, Ghost Lobby play, debrief, and restart", priority = "critical" },
  { item = "Validate the Bevy frontend in a real window and establish performance/accessibility baselines", priority = "critical" },
  { item = "Add a first intentional art, UI, and sound pass", priority = "high" },
  { item = "Write the era ledger, initial region trope definitions, and story-bible skeleton", priority = "high" },
  { item = "Define persistence/versioning using the existing snapshot and event-log substrate", priority = "medium" },
]

[cross-repository-reconciliation]
coordination-id = "ums-idaptik-slavia-enaction-2026-07-25"
status = "landed on main in PR #45"
role = "Authoritative owner of IDApTIK package syntax, gameplay vocabulary, semantic validation, migrations, snapshots, package loading, and runtime execution."
settled = [
  "IDApTIK does not depend on the UMS user interface or UMS Core",
  "UMS consumes the IDApTIK-owned versioned contract",
  "IDApTIK does not import Chronicles of Slavia profile types",
  "Enaction adoption requires fresh game-host evidence",
]
